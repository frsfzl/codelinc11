# Optional. Speech-to-text requires the API key; live conversation also needs an agent.
# Server-only: never prefix the key with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Must exactly match the browser's origin when live mode is enabled.
APP_ORIGIN=http://127.0.0.1:3000
# Local-only alternative for dictation and agent session signing: an authenticated ElevenLabs CLI.
# Set the absolute path to the native executable, not a shell script or npm shim.
# Never enable this bridge on a hosted deployment; use ELEVENLABS_API_KEY there.
ELEVENLABS_USE_CLI=false
ELEVENLABS_CLI_PATH=
